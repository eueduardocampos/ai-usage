{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI Usage",
  "version": "3.0.0",
  "identifier": "com.eduardocampos.claude-usage",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Consumo de IA",
        "url": "index.html",
        "width": 640,
        "height": 350,
        "minWidth": 440,
        "minHeight": 350,
        "resizable": true,
        "fullscreen": false,
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "alwaysOnTop": true,
        "titleBarStyle": "Transparent",
        "hiddenTitle": true,
        "skipTaskbar": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "resources": {
      "engine/ai-usage-engine/": "engine/"
    }
  }
}
